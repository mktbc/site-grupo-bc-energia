# =============================================================================
# Variáveis de ambiente do site institucional (React + Vite)
# =============================================================================
# Copie este arquivo para `.env` na raiz do projeto e preencha os valores.
# Após alterar, reinicie o servidor de desenvolvimento (`npm run dev`).
#
# ⚠️  IMPORTANTE — segurança:
# Como o app é 100% client-side, TODA variável `VITE_*` vai para o bundle
# JavaScript enviado ao navegador e fica visível a qualquer visitante.
# Use apenas para valores públicos (webhooks públicos, links, IDs de tracking).
# NÃO coloque chaves privadas / tokens de servidor aqui.
# =============================================================================

# Webhook do n8n que recebe os formulários (antes: /api/form -> N8N_WEBHOOK_URL)
VITE_FORM_WEBHOOK_URL=

# API interna
VITE_API=

# Salesforce — usado pelo componente Numbers
VITE_SALESFORCE_API=

# Blog
VITE_BLOG_API=

# Segmentos (opcional — há dados locais em src/data/segments)
VITE_SEGMENTS_API=

# WhatsApp
VITE_WHATSAPP_LINK=https://wa.link/o6o37f
VITE_WHATSAPP_LINK_PARCERIAS=https://wa.me/5562981632741
VITE_WHATSAPP_LINK_COMPRAS=https://wa.me/5562981590131

# RD Station
VITE_RDSTATION_TRACKING_CODE_SCRIPT_URL=

# Página de Vagas
VITE_VAGAS_URL=https://grupobcenergia.vagas.solides.com.br

# Google Tag Manager (opcional)
VITE_GTM_ID=
